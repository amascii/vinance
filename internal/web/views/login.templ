package views

// LoginPage is the password form. It has no site nav: there is nothing to navigate to until you are in.
templ LoginPage(next, errMsg string) {
	@bareLayout("Log in · vinance") {
		<main class="container login">
			<article>
				<h1>vinance</h1>
				<form method="post" action="/login">
					<input type="hidden" name="next" value={ next }/>
					<label>
						Password
						<input type="password" name="password" autocomplete="current-password" autofocus required aria-invalid?={ errMsg != "" }/>
					</label>
					if errMsg != "" {
						<small class="error" role="alert">{ errMsg }</small>
					}
					<button type="submit">Log in</button>
				</form>
			</article>
		</main>
	}
}
