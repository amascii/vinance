package views

// htmx swaps 422 responses (validation errors) like successes instead of discarding them.
const htmxConfig = `{"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"422","swap":true,"error":false},{"code":"[45]..","swap":false,"error":true},{"code":"...","swap":true}]}`

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/pico.min.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body>
			<header class="container">
				<nav>
					<ul><li><a href="/" class="brand"><strong>vinance</strong></a></li></ul>
					<ul><li><a href="/accounts">Accounts</a></li><li><a href="/tags">Tags</a></li><li><a href="/budgets">Budgets</a></li><li><a href="/recurring">Recurring</a></li><li><a href="/transactions">Transactions</a></li></ul>
				</nav>
			</header>
			<main class="container">
				{ children... }
			</main>
		</body>
	</html>
}
